{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "lib": [
      "ES2024",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "composite": false
  },
  "include": [
    "*.ts",
    "*.tsx",
    "auth/**/*",
    "share/**/*"
  ]
}