{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-updater",
  "description": "Allow the packaged local Pi Code UI to install signed pi-code-desktop releases.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart"
  ]
}
